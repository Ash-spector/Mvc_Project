
@model IEnumerable <Mvc_Project.Models.Student>

<h2 class="text-center text-bg-success text-info">Student Details</h2>

@Html.ActionLink("New Students", "Upsert", "Student", null, new { @class = "btn  btn-bg-info text-info" })

@if (!Model.Any())
{
    <p class="text-danger">DATA NOT FOUND</p>
}
else
{
    <table class="table table-bordered table-active table-striped">
        <thead>
            <tr>
                <th> Name</th>
                <th> Age</th>
                <th> Address</th>
                <th> Email</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var student in Model)
            {
                <tr>
                    <td>@student.Name</td>
                    <td>@student.Age</td>
                    <td>@student.Address</td>
                    <td>@student.Email</td>
                    <td>
                        @Html.ActionLink("Edit", "Upsert", "Student", new { id = student.Id }, new { @class = "btn btn-success" })
                        @Html.ActionLink("Detail", "Details", "Student", new { id = student.Id }, new { @class = "btn btn-primary" })
                        @Html.ActionLink("Delete", "Delete", "Student", new { id = student.Id }, new { @class = "btn btn-danger" })
                    </td>
                </tr>
            }
        </tbody>
    </table>

}
